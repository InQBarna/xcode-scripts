# Lowest fastlane tested with tests/smoke.sh (needs trainer with Xcode 16+ xcresult support and scan build_for_testing)
fastlane_version "2.242.0"

default_platform :ios

platform :ios do

  # Synchronize devices, prov profiles, etc..
  desc "Sends the devices list to developer portal"
  desc "Adds all the devices to the dev and adhoc prov profile"
  desc "Downloads all prov profiles"
  desc "Configures the project so it uses this new prov profiles"
  lane :update_devices_and_profiles do
    
    register_devices(
        devices_file: './fastlane/devices.txt',
    )

    match(type: "development",
          force_for_new_devices: true)
    match(type: "adhoc",
          force_for_new_devices: true)
    match(type: "appstore",
          force_for_new_devices: false)

  end

  desc "Installs profiles generated by team owner, no need for dev portal access"
  lane :install_profiles do

    match(type: "development",
          readonly: true)
    match(type: "adhoc",
          readonly: true)
    match(type: "appstore",
          readonly: true)

  end

  desc "Renews expired certificates and regenerates the provisioning profiles (development, adhoc, appstore)"
  desc "Deletes the existing match profiles of the Matchfile app identifiers first, so the new ones keep the exact names the project expects"
  desc "Run once a year when certificates expire. Needs write access to the match repo and dev portal access"
  desc "Use dry_run:true to only list the profiles that would be deleted"
  lane :renew_certs do |options|
    require "match"

    config = FastlaneCore::Configuration.create(Match::Options.available_options, {})
    config.load_configuration_file("Matchfile")
    identifiers = Array(config[:app_identifier])
    UI.user_error!("No app_identifier found in Matchfile") if identifiers.empty?

    # Without this, a profile that still holds the plain name makes match save the new one with a
    # timestamp suffix, which the project does not reference.
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: lane_context[SharedValues::APP_STORE_CONNECT_API_KEY])
    names = identifiers.flat_map { |id| %w[Development AdHoc AppStore].map { |type| /\Amatch #{type} #{Regexp.escape(id)}( \d+)?\z/ } }
    stale = Spaceship::ConnectAPI::Profile.all.select { |profile| names.any? { |name| name.match?(profile.name.to_s) } }
    stale.each do |profile|
      UI.important("#{options[:dry_run] ? 'Would delete' : 'Deleting'} profile #{profile.name} (#{profile.id})")
      profile.delete! unless options[:dry_run]
    end
    next if options[:dry_run]

    %w[development adhoc appstore].each do |type|
      match(type: type,
            renew_expired_certs: true,
            force: true)
    end
  end

  desc "Lists the certificates and the match provisioning profiles with their expiry dates"
  desc "warn_days:30 (default) marks what expires soon; strict:true makes the lane fail when something is expired, expiring or invalid (for a scheduled CI job)"
  desc "Read only: needs the App Store Connect API key, no match repo access"
  lane :check_certs do |options|
    iq_check_certs(warn_days: (options[:warn_days] || 30).to_i, strict: iq_true?(options[:strict]))
  end

  desc "Writes the devices registered on the developer portal to fastlane/devices.txt (enabled iOS devices)"
  desc "Uses the App Store Connect API key. dry_run:true only shows what would change. Then run update_devices_and_profiles"
  lane :sync_devices do |options|
    iq_sync_devices(dry_run: iq_true?(options[:dry_run]))
  end

  desc "Runs SwiftLint and SwiftFormat (lint mode, nothing is modified) when they are configured/installed"
  desc "strict:false lets SwiftLint warnings pass. Skips with a message when the project uses neither"
  lane :lint do |options|
    iq_lint(strict: options[:strict].nil? ? true : iq_true?(options[:strict]))
  end

end

def iq_firebase(appname:, schemename:, targetname:, xcprojname:, bundleid:, firebaseid:, testers_cs:)
  iq_firebase_v2(appname: appname, schemename: schemename, targetname: targetname, configuration: 'Release', xcprojname: xcprojname, bundleid: bundleid, firebaseid: firebaseid, testers_cs: testers_cs)
end

def iq_firebase_v2(appname:, schemename:, targetname:, configuration:, xcprojname:, bundleid:, firebaseid:, testers_cs:)

  clear_derived_data()

  setup_ci()

  match(type: "adhoc",
  	readonly: true)

  timest = Time.new.strftime("%Y%m%d%H%M")
  ENV["ENV_BUILD_NUMBER"] = timest

  increment_build_number(build_number: timest.to_i)

  # Building app for AdHoc distribution, match-styled profiles are  mandatory
  gym(scheme: schemename,
      clean: true,
      export_method: 'ad-hoc',
      configuration: configuration,
      export_options: {
        provisioningProfiles: {
          bundleid => "match AdHoc " + bundleid
        }
      }
  )

  # Collecting a changelog from commit list
  changelog = changelog_from_git_commits(
                  tag_match_pattern: "firebase-dist/*",
                  pretty: '• %s',
                  merge_commit_filtering: 'exclude_merges'
                  )
  changelog_empty = changelog.nil? || changelog.empty?
  changelog = 'no changes since last release' if changelog_empty

  firebase_app_distribution(
      app: firebaseid,
      testers: testers_cs,
      release_notes: changelog
  )

  upload_symbols_to_crashlytics(
      dsym_path: "./" + appname + ".app.dSYM.zip"
  )

  commit_version_bump(
      message: "Version Bump",
      xcodeproj: xcprojname + ".xcodeproj"
  )

  version = get_version_number(xcodeproj: xcprojname + ".xcodeproj", target: targetname)
  newTag = "firebase-dist/v" + version + "(" + timest + ")"
  add_git_tag(tag: newTag)
  push_git_tags

  clean_build_artifacts
end

