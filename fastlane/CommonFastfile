# -----------------------------------------------------------------------------
# CI build / test helpers
#
# Used by the `build` and `test` lanes of the project's Fastfile (generated by
# create_setup_build_scripts.sh), which scripts/build.sh and CI call.
#
# Environment variables (all optional):
#   RUNTIME                   iOS runtime to use, e.g. "18.2" (default: newest installed)
#   DEVICE                    simulator device, e.g. "iPhone 16" (default: newest iPhone)
#   MAX_WARNINGS              warnings allowed in the build log (default: 0)
#   DO_NOT_DELETE_SIMULATOR   keep the dedicated simulator created for Jenkins builds
# A dedicated, throw-away simulator is created when BUILD_NUMBER is set (Jenkins),
# so concurrent jobs on the same machine do not step on each other.
# -----------------------------------------------------------------------------

def iq_root
  File.expand_path('..', FastlaneCore::FastlaneFolder.path)
end

def iq_simctl_json(*args)
  require 'json'
  JSON.parse(sh("xcrun simctl list #{args.join(' ')} -j", log: false))
end

def iq_ios_runtime(requested = nil)
  runtimes = iq_simctl_json('runtimes', 'available')['runtimes'].select { |r| r['platform'] == 'iOS' || r['name'].to_s.start_with?('iOS ') }
  UI.user_error!("No iOS simulator runtime found, install one from Xcode > Settings > Components") if runtimes.empty?
  unless requested.to_s.empty?
    found = runtimes.find { |r| r['version'] == requested || r['version'].to_s.start_with?("#{requested}.") }
    UI.user_error!("iOS runtime #{requested} is not installed (available: #{runtimes.map { |r| r['version'] }.join(', ')})") if found.nil?
    return found
  end
  runtimes.max_by { |r| Gem::Version.new(r['version']) }
end

def iq_device_type(requested = nil)
  types = iq_simctl_json('devicetypes')['devicetypes']
  if requested.to_s.empty?
    iphones = types.select { |t| t['name'] =~ /\AiPhone \d+\z/ }
    UI.user_error!("No iPhone simulator device type found") if iphones.empty?
    return iphones.max_by { |t| t['name'][/\d+/].to_i }
  end
  found = types.find { |t| t['name'] == requested }
  UI.user_error!("Device type #{requested} not found, run `xcrun simctl list devicetypes`") if found.nil?
  found
end

# Returns {name:, runtime:, udid:, created:}. Creates (or resets) a dedicated simulator when running on Jenkins.
def iq_prepare_simulator
  runtime = iq_ios_runtime(ENV['RUNTIME'])
  device = iq_device_type(ENV['DEVICE'])
  sim = { name: device['name'], runtime: runtime['version'], udid: nil, created: false }
  return sim if ENV['BUILD_NUMBER'].to_s.empty?

  suffix = [ENV['JOB_NAME'], ENV['BUILD_NUMBER'][-1]].compact.join(' - ')
  sim[:name] = "#{device['name']} - #{suffix}"
  existing = (iq_simctl_json('devices')['devices'][runtime['identifier']] || []).find { |d| d['name'] == sim[:name] }
  if existing
    UI.message("Found #{sim[:name]}, resetting state")
    sh("xcrun simctl shutdown #{existing['udid']} || true", log: false)
    sh("xcrun simctl erase #{existing['udid']}")
    sim[:udid] = existing['udid']
  else
    sim[:udid] = sh("xcrun simctl create '#{sim[:name]}' #{device['identifier']} #{runtime['identifier']}", log: false).strip
  end
  sim[:created] = true
  sim
end

def iq_cleanup_simulator(sim)
  return if sim.nil? || !sim[:created]
  if ENV['DO_NOT_DELETE_SIMULATOR'].to_s.empty?
    sh("xcrun simctl shutdown #{sim[:udid]} || true", log: false)
    sh("xcrun simctl delete #{sim[:udid]}", log: false)
  else
    UI.message("#{sim[:name]} not deleted")
  end
end

# Counts compiler/linker warnings in an xcodebuild log. Warnings in Swift packages (dependencies) are ignored.
def iq_warnings_in_log(log_path)
  UI.user_error!("Build log not found at #{log_path}") unless File.exist?(log_path)
  File.readlines(log_path, encoding: 'UTF-8').map { |l| l.scrub.chomp }
      .select { |l| l =~ %r{\A(/.+:\d+:\d+: |ld: )warning:} }
      .reject { |l| l.include?('/SourcePackages/') }
      .uniq
end

def iq_check_warnings(log_path)
  max = (ENV['MAX_WARNINGS'] || '0').to_i
  warnings = iq_warnings_in_log(log_path)
  if warnings.count > max
    UI.error(warnings.join("\n"))
    UI.user_error!("There are #{warnings.count} warnings, invalid build (max allowed warnings: #{max})")
  end
  UI.success("Nice, #{warnings.count} warnings")
end

def iq_build_for_simulator(schemename:, xcprojname:, sim:, for_testing:, derived_data:)
  log_dir = File.join(iq_root, 'gymbuildlog')
  FileUtils.rm_rf(log_dir)
  gym(project: File.join(iq_root, "#{xcprojname}.xcodeproj"),
      scheme: schemename,
      skip_archive: true,
      skip_package_ipa: true,
      configuration: 'Debug',
      destination: "platform=iOS Simulator,name=#{sim[:name]},OS=#{sim[:runtime]}",
      buildlog_path: log_dir,
      xcargs: for_testing ? 'clean build-for-testing' : 'clean',
      derived_data_path: derived_data)
  iq_check_warnings(File.join(log_dir, "#{xcprojname}-#{schemename}.log"))
end

def iq_touch_report(path)
  FileUtils.mkdir_p(File.dirname(path))
  FileUtils.touch(path)
end

# Builds the app for the simulator and fails if there are warnings.
# Touches the CI result files (coverage / junit) so CI publishers do not complain.
def iq_build(schemename:, xcprojname:)
  derived_data = File.join(iq_root, 'deriveddata')
  sim = iq_prepare_simulator
  begin
    iq_build_for_simulator(schemename: schemename, xcprojname: xcprojname, sim: sim, for_testing: false, derived_data: derived_data)
    iq_touch_report(File.join(iq_root, 'coverage', 'cobertura.xml'))
    iq_touch_report(File.join(iq_root, 'fastlane', 'test_output', 'report.junit'))
    iq_touch_report(File.join(iq_root, 'fastlane', 'test_output_ui', 'report.junit'))
  ensure
    iq_cleanup_simulator(sim)
    FileUtils.rm_rf(derived_data)
    FileUtils.rm_rf(File.join(iq_root, 'gymbuildlog'))
  end
end

# Builds (zero warnings), runs unit tests with coverage (coverage/cobertura.xml) and, optionally, UI tests.
# UI test failures do not fail the lane by default (they are reported in fastlane/test_output_ui/report.junit);
# pass fail_on_ui_test_failure: true to change it. Pass concurrent_ui_tests: false to disable parallel UI tests.
def iq_test(schemename:, xcprojname:, test_target:, ui_test_target: '', concurrent_ui_tests: true, fail_on_ui_test_failure: false)
  derived_data = File.join(iq_root, 'deriveddata')
  project = File.join(iq_root, "#{xcprojname}.xcodeproj")
  sim = iq_prepare_simulator
  device = "#{sim[:name]} (#{sim[:runtime]})"
  destination = "platform=iOS Simulator,name=#{sim[:name]},OS=#{sim[:runtime]}"
  begin
    FileUtils.rm_rf(derived_data)
    iq_build_for_simulator(schemename: schemename, xcprojname: xcprojname, sim: sim, for_testing: true, derived_data: derived_data)

    scan(project: project,
         scheme: schemename,
         test_without_building: true,
         devices: [device],
         code_coverage: true,
         clean: false,
         only_testing: [test_target],
         derived_data_path: derived_data)

    UI.message("Building code coverage result")
    slather(cobertura_xml: true,
            output_directory: File.join(iq_root, 'coverage'),
            ignore: ['*/SourcePackages/*'],
            build_directory: derived_data,
            scheme: schemename,
            proj: project)

    ui_output = File.join(iq_root, 'fastlane', 'test_output_ui')
    FileUtils.rm_rf(ui_output)
    if ui_test_target.to_s.empty?
      iq_touch_report(File.join(ui_output, 'report.junit'))
    else
      xcargs = concurrent_ui_tests ? '-parallel-testing-enabled YES -parallel-testing-worker-count 3' : '-parallel-testing-enabled NO'
      scan(project: project,
           scheme: schemename,
           test_without_building: true,
           devices: [device],
           destination: destination,
           code_coverage: false,
           clean: false,
           only_testing: [ui_test_target],
           output_directory: ui_output,
           result_bundle: true,
           xcargs: xcargs,
           derived_data_path: derived_data,
           fail_build: fail_on_ui_test_failure)
      iq_ui_junit_report(ui_output, sim)
    end
  ensure
    iq_cleanup_simulator(sim)
    FileUtils.rm_rf(derived_data)
    FileUtils.rm_rf(File.join(iq_root, 'gymbuildlog'))
  end
end

# Builds fastlane/test_output_ui/report.junit from the UI tests' xcresult using xchtmlreport (brew install xctesthtmlreport)
def iq_ui_junit_report(ui_output, sim)
  report = File.join(ui_output, 'report.junit')
  xcresult = Dir.glob(File.join(ui_output, '*.xcresult')).first
  if xcresult.nil? || `which xchtmlreport`.strip.empty?
    UI.important("Could not build the UI tests junit report (#{xcresult.nil? ? 'no xcresult found' : 'xchtmlreport not installed'})")
    return iq_touch_report(report)
  end
  sh("xchtmlreport -j --lenient '#{xcresult}'")
  generated = File.join(xcresult, 'report.junit')
  # Test names include the simulator, strip it so results are comparable between runs
  File.write(report, File.read(generated).gsub(" - #{sim[:name]} - #{sim[:runtime]}", ''))
end

# -----------------------------------------------------------------------------
# App Store Connect API key
#
# Call it from before_all in the project's Fastfile for the lanes that talk to Apple.
# On CI, prefer env vars (secrets) over files committed to the repo:
#   ASC_KEY_ID, ASC_ISSUER_ID   override the ids passed as arguments
#   ASC_KEY_P8                  content of the AuthKey_XXXX.p8 file (takes precedence over key_filepath)
# -----------------------------------------------------------------------------
# Paths in a Fastfile are ambiguous (fastlane runs inside the fastlane/ folder). Accept paths relative to
# either the current folder or the project root, like "./fastlane/AuthKey_XXXX.p8".
def iq_resolve_path(path)
  return path if path.nil? || path.empty?
  return File.expand_path(path) if File.exist?(path)
  from_root = File.join(iq_root, path)
  File.exist?(from_root) ? from_root : path
end

def iq_asc_api_key(key_id: '', issuer_id: '', key_filepath: nil)
  content = ENV['ASC_KEY_P8'].to_s.empty? ? nil : ENV['ASC_KEY_P8']
  app_store_connect_api_key(
    key_id: ENV['ASC_KEY_ID'] || key_id,
    issuer_id: ENV['ASC_ISSUER_ID'] || issuer_id,
    key_content: content,
    key_filepath: content ? nil : iq_resolve_path(key_filepath),
    in_house: false
  )
end
