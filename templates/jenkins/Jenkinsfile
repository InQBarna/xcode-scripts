// Builds and tests the app; optionally sends a version to Firebase or TestFlight.
// Generated by https://github.com/InQBarna/xcode-scripts. Runs ./scripts/setup.sh and ./scripts/build.sh.
//
// Needs: a macOS agent labelled 'macos' with Xcode, and (for distribution) these credentials:
//   match-passphrase     Secret text   passphrase of the match repo
//   asc-api-key-p8       Secret file   AuthKey_XXXX.p8 (key id / issuer id go in fastlane/Fastfile or ASC_KEY_ID / ASC_ISSUER_ID)
// Publishing results uses the JUnit plugin and the Cobertura (or Coverage) plugin.
pipeline {
    agent { label 'macos' }

    options {
        timeout(time: 90, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        choice(name: 'INTENT', choices: ['test', 'build', 'firebase', 'appstore'],
               description: 'test: build + tests, build: build only, firebase: test version to Firebase, appstore: TestFlight')
    }

    stages {
        stage('Setup') {
            steps { sh './scripts/setup.sh' }
        }

        stage('Build / test') {
            when { expression { params.INTENT in ['test', 'build'] } }
            steps {
                // build.sh builds only when INTENT is not "test"
                sh "INTENT=${params.INTENT == 'test' ? 'test' : ''} ./scripts/build.sh"
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'fastlane/test_output/report.junit, fastlane/test_output_ui/report.junit'
                    cobertura autoUpdateHealth: false, autoUpdateStability: false, coberturaReportFile: 'coverage/cobertura.xml', failNoReports: false
                }
            }
        }

        stage('Distribute') {
            when { expression { params.INTENT in ['firebase', 'appstore'] } }
            steps {
                withCredentials([string(credentialsId: 'match-passphrase', variable: 'MATCH_PASSPHRASE'),
                                 file(credentialsId: 'asc-api-key-p8', variable: 'ASC_KEY_FILE')]) {
                    sh '''
                        export ASC_KEY_P8="$(cat "$ASC_KEY_FILE")"
                        INTENT=${INTENT} ./scripts/build.sh
                    '''
                }
            }
        }
    }
}
