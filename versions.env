# Versions that NEW projects get from the generator (they own them afterwards, in their own files).
# Only versions that tests/smoke.sh has passed with belong here. Do not edit by hand to chase "latest":
# .github/workflows/versions.yml tests the newest Ruby every week and opens a PR bumping this line when it passes.
# (Bundler is the one that ships with this Ruby, fastlane is resolved by bundler; the project's Gemfile.lock pins them.)
RUBY_VERSION=4.0.10
